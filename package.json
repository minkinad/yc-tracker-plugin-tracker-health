{
  "name": "yc-tracker-plugin-tracker-health",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "type": "module",
  "keywords": [
    "react",
    "vite",
    "typescript",
    "gravity-ui",
    "yandex-tracker"
  ],
  "description": "Quality gate for Yandex Tracker issues",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --logLevel silent",
    "build": "tsc && node node_modules/vite/bin/vite.js build",
    "lint:js": "eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:styles": "stylelint '{styles,src}/**/*.{css,scss}' --allow-empty-input",
    "lint": "npm run lint:js && npm run lint:styles && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gravity-ui/icons": "2.18.0",
    "@gravity-ui/uikit": "7.37.0",
    "@weavix/tracker-api-types": "0.0.8",
    "@weavix/tracker-components": "0.1.5",
    "@weavix/tracker-plugin-sdk-react": "0.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@gravity-ui/browserslist-config": "4.1.0",
    "@gravity-ui/eslint-config": "4.2.0",
    "@gravity-ui/prettier-config": "1.1.0",
    "@gravity-ui/stylelint-config": "4.0.0",
    "@gravity-ui/tsconfig": "1.0.0",
    "@types/node": "^25.0.10",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "@types/react-test-renderer": "^18.3.1",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "react-test-renderer": "^18.3.1",
    "sass": "1.99.0",
    "typescript": "5.8.3",
    "vite": "8.0.16",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.0"
  },
  "browserslist": [
    "extends @gravity-ui/browserslist-config"
  ],
  "lint-staged": {
    "*.{css,scss}": [
      "stylelint --fix --quiet"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix --quiet",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
